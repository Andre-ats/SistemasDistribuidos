
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /src

COPY pom.xml .
COPY Common/pom.xml Common/
COPY Server/pom.xml Server/
COPY Cliente/pom.xml Cliente/
COPY Referencia/pom.xml Referencia/

COPY Common/ Common/
COPY Cliente/ Cliente/

RUN mvn -q -B -pl Cliente -am package

FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build /src/Cliente/target/cliente.jar .

ENTRYPOINT ["java", "-Dstdout.encoding=UTF-8", "-Dstderr.encoding=UTF-8", "-jar", "cliente.jar"]
